# VERIDEX Environment Configuration Example

# Target Database URL Configuration
# For Local SQLite Development/Testing (Default):
DATABASE_URL=sqlite:///./veridex_dev.db

# For Production PostgreSQL Container:
# DATABASE_URL=postgresql+psycopg2://veridex:veridex_pass@localhost:5432/veridex

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_DB=veridex
POSTGRES_USER=veridex
POSTGRES_PASSWORD=veridex_pass
POSTGRES_PORT=5432

# Security & Authentication Secrets
SECRET_KEY=veridex_super_secret_jwt_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM Provider Configuration
# Options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
